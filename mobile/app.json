{
  "expo": {
    "name": "Kooa",
    "slug": "neobanco",
    "owner": "jschmidtr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cr.ariatech.kooa",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para que ingreses a tu cuenta de forma segura.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B4F4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "cr.ariatech.kooa",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "kooa",
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para que ingreses a tu cuenta de forma segura."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Usamos tus fotos solo para que elijas tu foto de perfil.",
          "cameraPermission": "Usamos la cámara solo para que te tomes la foto de perfil."
        }
      ]
    ],
    "runtimeVersion": "exposdk:58.0.0",
    "updates": {
      "url": "https://u.expo.dev/f8736c4b-3156-4706-88f8-ed0a02180b15"
    },
    "extra": {
      "eas": {
        "projectId": "f8736c4b-3156-4706-88f8-ed0a02180b15"
      }
    }
  }
}
