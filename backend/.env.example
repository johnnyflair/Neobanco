# Copiá este archivo a .env para desarrollo local. Nunca subas un .env al repositorio.
NEO_ENV=local
NEO_DATABASE_URL=postgresql+asyncpg://neo:neo@localhost:5432/neobanco
NEO_REDIS_URL=redis://localhost:6379/0
NEO_JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio
NEO_EXPOSE_DEBUG_OTP=true
NEO_CORS_ORIGINS=["http://localhost:8081"]
